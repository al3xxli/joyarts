{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "routes": [
    {
      "src": "/(?!robots\\.txt$).*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-SearchBot|Claude-User|PerplexityBot|Perplexity-User|CCBot|meta-externalagent|meta-externalfetcher|Amazonbot|Amzn-SearchBot|Amzn-User|Bytespider).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
